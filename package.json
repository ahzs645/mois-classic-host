{
  "name": "@webforms/mois-classic-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MOIS classic (PowerBuilder) host emulator: a CSS kit, React screens rebuilt from the training environment, and the host-emulator contract Webforms embeds as a tutorial stage.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/host/manifest.ts",
    "./kit.css": "./src/pb/kit.css",
    "./package.json": "./package.json",
    "./tree": "./src/pb/components/tree.ts",
    "./tree.css": "./src/pb/tree.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.5",
    "vite": "8.3.1"
  }
}
